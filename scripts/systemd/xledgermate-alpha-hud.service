[Unit]
Description=xLedgerMate Alpha operator HUD (FastAPI :8765)
After=network-online.target xledgermate-alpha.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/xledgermate
Environment=XLEDGERMATE_ROOT=/root/xledgermate
EnvironmentFile=-/root/xledgermate/.env
ExecStart=/bin/bash /root/xledgermate/scripts/start_alpha_hud.sh
Restart=on-failure
RestartSec=5
MemoryAccounting=yes
MemoryMax=900M

[Install]
WantedBy=multi-user.target
