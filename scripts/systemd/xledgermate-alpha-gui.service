[Unit]
Description=xLedgerMate Alpha operator GUI (Streamlit)
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/xledgermate
ExecStart=/root/xledgermate/.venv/bin/streamlit run alpha/gui/streamlit_app.py --server.address 127.0.0.1 --server.port 8503 --server.headless true
Restart=on-failure

[Install]
WantedBy=multi-user.target
