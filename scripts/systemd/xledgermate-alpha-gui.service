[Unit]
Description=xLedgerMate Alpha operator GUI (Streamlit)
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/xledgermate
Environment=XLEDGERMATE_ROOT=/root/xledgermate
ExecStart=/root/xledgermate/scripts/start_alpha_gui.sh
Restart=on-failure

[Install]
WantedBy=multi-user.target
